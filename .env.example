# ======================================================================
# OMENA Autonomous Agentic IDE & Mobile Workbench - Environment Config
# ======================================================================

# Server Network Configuration
NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# Master Administrator Password (Required for HttpOnly Session Cookie Login)
ADMIN_PASSWORD=change_this_to_a_secure_admin_password_in_production

# Execution Profile & Privileges
# EXECUTION_MODE: 'container' (default, safe container isolation) or 'host' (direct host execution)
# EXECUTION_PRIVILEGE: 'standard' (default unprivileged appuser) or 'admin' (elevated administrative privilege)
EXECUTION_MODE=container
EXECUTION_PRIVILEGE=standard

# Storage & Directory Layout
# Defaults correspond to the standardized /opt/omena/ layout inside Docker
WORKSPACE_ROOT=/app/workspace
STORAGE_DIR=/app/storage
DATABASE_PATH=/app/storage/workbench.db

# Headless Browser Automation Configuration
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ======================================================================
# AI Model Provider Credentials (Optional)
# If left empty, the built-in autonomous deterministic planner executes
# tasks directly across all Workbench tools without external dependencies.
# ======================================================================

# Google Gemini API
GEMINI_API_KEY=

# OpenAI / ChatGPT API
OPENAI_API_KEY=

# Anthropic Claude API
ANTHROPIC_API_KEY=

# DeepSeek API
DEEPSEEK_API_KEY=

# Local Model Endpoint (Ollama or llama.cpp OpenAI-compatible server)
LOCAL_AI_URL=http://host.docker.internal:11434/v1
